# Nested settings use "__" as delimiter. Defaults live in core/config.py.
LOG_LEVEL=INFO

# ===== Qdrant =====
QDRANT__URL=http://localhost:6333
QDRANT__API_KEY=
# Embedded Qdrant without Docker (dev only): QDRANT__PATH=./qdrant_local
QDRANT__COLLECTION=chatbot_collection
QDRANT__TIMEOUT=30

# ===== Embedding =====
EMBEDDING__MODEL=intfloat/multilingual-e5-small
EMBEDDING__DEVICE=cpu
EMBEDDING__BATCH_SIZE=64

# ===== LLM (provider: ollama | openai) =====
LLM__PROVIDER=ollama
LLM__MODEL=qwen2.5:3b
LLM__BASE_URL=http://localhost:11434
LLM__API_KEY=
LLM__TEMPERATURE=0.2
LLM__MAX_TOKENS=1024
LLM__TIMEOUT=60

# ===== Retrieval =====
RETRIEVAL__DENSE_K=20
RETRIEVAL__BM25_K=20
RETRIEVAL__RRF_K=60
RETRIEVAL__CANDIDATES_N=20

# ===== Reranker =====
RERANK__ENABLED=true
RERANK__MODEL=BAAI/bge-reranker-v2-m3
RERANK__DEVICE=cpu
RERANK__TOP_K=5
RERANK__MIN_SCORE=0.01

# ===== Session memory =====
MEMORY__MAX_MESSAGES=5
MEMORY__TTL_SECONDS=1800
MEMORY__MAX_SESSIONS=1000

# ===== API =====
API__MAX_MESSAGE_LENGTH=500
API__RATE_LIMIT_PER_MINUTE=60
API__CORS_ORIGINS=["http://localhost:5173"]
